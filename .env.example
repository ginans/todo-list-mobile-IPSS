# Configuración de Entorno - ToDo List IPSS
# Modo Demo (Feature Flag): true = usa datos simulados (mock) en memoria/storage; false = conecta a API REST (NestJS)
EXPO_PUBLIC_DEMO_MODE=true

# URL base para conexión en modo API (para Unidades 2 y 3)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Ambiente de ejecución
EXPO_PUBLIC_APP_ENV=development
